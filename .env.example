# Voice-WebUI configuration
# Copia este archivo a .env y edita los valores

# Flask
FLASK_SECRET_KEY=change-me-in-production

# LLM (llama.cpp)
# OJO: si existe config.json (la app lo crea al arrancar, esta en .gitignore),
# su valor MANDA y el de aqui se queda sin efecto. La app avisa por consola
# cuando los dos difieren. Para cambiar la URL en caliente, edita config.json
# o el panel de la UI, no este archivo.
LLAMA_URL=http://localhost:8080/v1/chat/completions
LLAMA_MODEL=qwen3.6-35b
LLAMA_TEMPERATURE=0.6

# Whisper
WHISPER_MODEL=small

# MCP config path
MCP_CONFIG_PATH=./mcp-config.json

# llama-memory service
MEMORY_URL=http://localhost:9001

# User identifier for llama-memory
MEMORY_USER=default

# Credenciales para run_powershell_admin (comandos con privilegios).
# IMPORTANTE: comillas SIMPLES en ADMIN_USER. python-dotenv interpreta escapes
# dentro de comillas dobles: "DOMINIO\administrador" convierte \a en BEL
# (0x07), el usuario queda corrupto y WinRM responde "Acesso negado".
# ADMIN_ALLOWED_HOSTS es una allowlist: el LLM maneja estas credenciales y sin
# esta lista podria usarlas contra cualquier host de la red. Un host fuera de
# la lista se rechaza sin intentar la conexion.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_ALLOWED_HOSTS='localhost'
